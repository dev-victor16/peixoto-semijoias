# ==============================================================================
# PEIXOTO SEMI JOIAS — ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env.local no ambiente local:
#   cp .env.example .env.local
# No Render, cadastre cada variável na aba "Environment" do seu Web Service.
# NUNCA insira senhas reais neste arquivo .env.example.
# ==============================================================================

# [OBRIGATÓRIO EM PRODUÇÃO] Chave secreta de alta entropia para assinatura dos JWTs de sessão admin
# Dica de geração segura: openssl rand -base64 32
JWT_SECRET=sua-chave-secreta-longa-e-aleatoria-para-jwt-aqui

# [OPCIONAL / RECOMENDADO NO PRIMEIRO SETUP] Token para criar o primeiro usuário administrador via /api/auth/setup
# Se não fornecido, a rota de setup automático permanece desativada por segurança.
ADMIN_SETUP_TOKEN=seu-token-de-seguranca-para-criar-admin-inicial

# [OPCIONAL] Número do WhatsApp oficial da loja com DDD para recebimento dos pedidos
# Formato: 55 + DDD + Número (exemplo: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=5511999999999

# [OPCIONAL] Caminho do arquivo de banco de dados SQLite (útil caso use Persistent Disk no Render)
# Padrão: ./data/peixoto.db (ou /var/data/peixoto.db se montar um disco persistente)
DATABASE_PATH=
